# Токен бота из @BotFather (обязателен)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Базовый URL сервиса buh-ai-agent
AGENT_BASE_URL=http://127.0.0.1:8000

# Таймаут HTTP-запросов к агенту (/chat может думать несколько минут)
AGENT_TIMEOUT=5m

# Белый список Telegram user_id через запятую (пусто — разрешено всем)
ALLOWED_USER_IDS=

# Уровень логирования: debug|info|warn|error
LOG_LEVEL=info
